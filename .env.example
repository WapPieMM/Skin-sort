# Set real values in Vercel Project Settings > Environment Variables.
# Never commit real credentials or Supabase service-role keys.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Supabase values will be used by the server-side Storage API in the next step.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

SUPABASE_STORAGE_BUCKET=skin-images
